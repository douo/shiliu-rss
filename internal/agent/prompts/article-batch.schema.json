{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shiliu article cards v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "1" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_id", "status", "points", "limitation"],
        "properties": {
          "article_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "status": { "enum": ["ok", "insufficient"] },
          "points": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "evidence_ids"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1, "maxLength": 128 }
                }
              }
            }
          },
          "limitation": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
