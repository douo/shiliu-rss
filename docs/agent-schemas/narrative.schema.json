{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shiliu grounded narrative v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blocks"],
  "properties": {
    "schema_version": { "const": "1" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "evidence_ids"],
        "properties": {
          "kind": { "enum": ["fact", "analysis", "limitation"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence_ids": {
            "type": "array",
            "maxItems": 40,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["fact", "analysis"] } } },
            "then": { "properties": { "evidence_ids": { "type": "array", "minItems": 1 } } }
          }
        ]
      }
    }
  }
}
