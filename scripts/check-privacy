#!/usr/bin/env python3
"""Check tracked content (and optionally reachable history) without printing values."""
import argparse
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def git(*args):
    return subprocess.check_output(['git', '-C', str(ROOT), *args])


def private_file(path):
    p = pathlib.PurePosixPath(path)
    name = p.name.lower()
    if path == 'config/dev.env' or name.endswith('.example'):
        return False
    return (
        any(part in {'.local', '.ssh', 'node_modules', 'test-results', 'playwright-report', 'data', 'backups'} for part in p.parts)
        or name == '.env' or name.startswith('.env.') or name.endswith('.env')
        or name.endswith(('.db', '.db-wal', '.db-shm', '.db.lock', '.sqlite', '.sqlite3', '.ndjson', '.dump', '.pem', '.key', '.p12', '.pfx', '.bundle', '.tar', '.tar.gz', '.log'))
        or name in {'credentials.json', 'auth.json', 'id_rsa', 'id_ed25519'}
    )


PATTERNS = {
    'private-key': re.compile(rb'-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'),
    'github-token': re.compile(rb'\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{30,})\b'),
    'model-key': re.compile(rb'\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{24,}\b'),
    'home-directory': re.compile(rb'/(?:Users|home)/[A-Za-z0-9_.-]+/'),
    'local-registry-id': re.compile(rb'\bSVC_[A-Z0-9]{12,}\b'),
}
PRIVATE_IP = re.compile(rb'\b(?:192\.168\.\d{1,3}\.\d{1,3}|10\.(?:\d{1,3}\.){2}\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})\b')


def inspect(path, data):
    findings = set()
    if private_file(path):
        findings.add((path, 0, 'private-file'))
    if b'\0' in data:
        return findings
    for rule, pattern in PATTERNS.items():
        for match in pattern.finditer(data):
            findings.add((path, data.count(b'\n', 0, match.start()) + 1, rule))
    # RFC1918 addresses can be intentional SSRF test vectors; restrict this rule
    # to user-facing docs and application examples, not network test fixtures.
    if path.endswith('.md') or path.startswith('web/src/'):
        for match in PRIVATE_IP.finditer(data):
            findings.add((path, data.count(b'\n', 0, match.start()) + 1, 'private-network-example'))
    return findings


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--history', action='store_true', help='also inspect every blob reachable from local refs')
    args = parser.parse_args()
    findings = set()
    paths = [p.decode() for p in git('ls-files', '-z').split(b'\0') if p]
    for path in paths:
        file = ROOT / path
        if file.is_symlink():
            findings |= inspect(path, str(file.readlink()).encode())
        elif file.is_file():
            findings |= inspect(path, file.read_bytes())
        else:
            findings.add((path, 0, 'missing-tracked-file'))
    blobs = 0
    if args.history:
        records = git('rev-list', '--objects', '--all').splitlines()
        batch = subprocess.run(
            ['git', '-C', str(ROOT), 'cat-file', '--batch-check=%(objectname) %(objecttype)'],
            input=b'\n'.join(row.split(b' ', 1)[0] for row in records) + b'\n',
            stdout=subprocess.PIPE, check=True,
        ).stdout.splitlines()
        for row, meta in zip(records, batch, strict=True):
            if not meta.endswith(b' blob') or b' ' not in row:
                continue
            oid, path = row.split(b' ', 1)
            findings |= inspect(path.decode(), git('cat-file', 'blob', oid.decode()))
            blobs += 1
    for path, line, rule in sorted(findings):
        print(f'{path}:{line}: {rule}', file=sys.stderr)
    if findings:
        print(f'Privacy check failed: {len(findings)} locations; values omitted.', file=sys.stderr)
        return 1
    print(f'Privacy check passed: {len(paths)} tracked files' + (f', {blobs} historical blobs.' if args.history else '.'))
    return 0


if __name__ == '__main__':
    sys.exit(main())
