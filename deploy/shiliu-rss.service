[Unit]
Description=Shiliu RSS reader and scheduled Agent
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/opt/shiliu-rss/data /srv/backups/shiliu-rss

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/opt/shiliu-rss
ExecStart=/usr/bin/docker compose -f compose.yaml up -d --pull never
ExecStop=/usr/bin/docker compose -f compose.yaml stop
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
